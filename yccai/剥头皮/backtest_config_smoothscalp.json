{
    "strategy": "SmoothScalp",
    "timeframe": "1m",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "trading_mode": "spot",
    "margin_mode": "",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "okx",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ],
        "pair_blacklist": [
            ".*UP/.*",
            ".*DOWN/.*",
            ".*BEAR/.*",
            ".*BULL/.*"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "edge": {
        "enabled": false
    },
    "freqai": {
        "enabled": false,
        "identifier": "example",
        "write_metrics_to_disk": false,
        "purge_old_models": 2,
        "conv_width": 1,
        "train_period_days": 0,
        "backtest_period_days": 7,
        "live_retrain_hours": 0,
        "expiration_hours": 0,
        "save_backtest_models": false,
        "activate_tensorboard": true,
        "wait_for_training_iteration_on_reload": true,
        "continual_learning": false,
        "keras": false,
        "feature_parameters": {
            "include_timeframes": ["5m", "15m", "4h"],
            "include_corr_pairlist": ["ETH/USDT", "LTC/USDT"],
            "label_period_candles": 24,
            "include_shifted_candles": 2,
            "DI_threshold": 0.9,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": false,
            "indicator_periods_candles": [10, 20, 30]
        },
        "data_split_parameters": {
            "test_size": 0.25,
            "random_state": 1,
            "shuffle": false
        },
        "model_training_parameters": {
            "n_estimators": 100
        }
    },
    "bot_name": "SmoothScalp_Backtest",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "stake_amount": 100,
    "stake_currency": "USDT",
    "max_open_trades": 10,
    "max_open_trades_timeframe": "1h"
}
